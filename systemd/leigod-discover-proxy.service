[Unit]
Description=Leigod bridge-mode LAN discovery proxy
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/leigod-discover-proxy --bind @BIND_ADDRESS@ --container @CONTAINER_IP@
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET
SystemCallArchitectures=native
MemoryMax=32M
TasksMax=16

[Install]
WantedBy=multi-user.target
